root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.md,*.mdx}]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.{json,jsonc}]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2
