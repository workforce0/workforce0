# =============================================================================
# WORKFORCE0 — ROOT ENVIRONMENT (self-hosted)
# =============================================================================
#
# Copy to `.env` and fill in values. NEVER commit `.env` to git.
#
# For a basic setup, you only need to fill in the REQUIRED section.
# Everything else can be configured from the in-app setup wizard after install.
#
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — minimum to boot
# -----------------------------------------------------------------------------

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Generate with: openssl rand -base64 32
JWT_SECRET=change_me_32_characters_minimum_xxxxxxxx

# Your Google Gemini API key (free tier works)
# Get one: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Public URL where users will access Workforce0
# Example: https://workforce0.yourcompany.com  (or http://localhost:3001 for dev)
PUBLIC_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# OPTIONAL — extra AI Council models (bring your own)
# -----------------------------------------------------------------------------

# Anthropic Claude key (enables Claude as critique / coder model)
# Get one: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI key (enables OpenAI as critique model)
# Get one: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — port configuration
# -----------------------------------------------------------------------------

BACKEND_PORT=3000
FRONTEND_PORT=3001

# -----------------------------------------------------------------------------
# OPTIONAL — integrations (all configurable from the in-app wizard later)
# -----------------------------------------------------------------------------

# Jira
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_DEFAULT_PROJECT=

# Google Chat webhook
# GCHAT_WEBHOOK_URL=

# Twilio (voice dial-in)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Public webhook URL (for Twilio / OAuth callbacks; use ngrok in dev)
# PUBLIC_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# ADVANCED — only touch if you know what you're doing
# -----------------------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_DB=workforce0
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
ENABLE_AI_FALLBACK=true
