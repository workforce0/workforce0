# =============================================================================
# WORKFORCE0 MVP ENVIRONMENT CONFIGURATION
# =============================================================================
#
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
#
# Required services for MVP:
# - PostgreSQL database
# - Redis for sessions and queues
# - Gemini API for AI
#
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------

# Node environment (development, staging, production)
NODE_ENV=development

# Server port
PORT=3000

# Server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST=0.0.0.0

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workforce0

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------

# Redis connection URL
# Format: redis://user:password@host:port/db
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# AI SERVICES
# -----------------------------------------------------------------------------

# Google Gemini API key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# JIRA CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
# Required for creating Jira tickets from PRDs

# Jira Cloud instance URL
# Example: https://yourcompany.atlassian.net
JIRA_BASE_URL=

# Jira email (associated with API token)
JIRA_EMAIL=

# Jira API token
# Get from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Default Jira project key
JIRA_DEFAULT_PROJECT=

# Custom field ID for story points (optional)
# Find via: /rest/api/3/field
JIRA_STORY_POINTS_FIELD=

# -----------------------------------------------------------------------------
# GOOGLE CHAT CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
# Required for sending notifications to Google Chat

# Google Chat webhook URL
# Get from: Google Chat space settings → Apps & integrations → Webhooks
GCHAT_WEBHOOK_URL=

# Default thread key for grouping messages (optional)
GCHAT_DEFAULT_THREAD_KEY=

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------

# JWT secret for API authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# API key for service-to-service authentication
# Generate with: openssl rand -hex 32
API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------

# Allowed origins (comma-separated)
# Example: http://localhost:3000,https://app.workforce0.com
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------

# Max requests per minute per IP
RATE_LIMIT_MAX=100

# Rate limit window in milliseconds
RATE_LIMIT_WINDOW=60000

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------

# Enable debug endpoints (NEVER in production)
ENABLE_DEBUG_ENDPOINTS=false

# Enable AI model fallback
ENABLE_AI_FALLBACK=true

# -----------------------------------------------------------------------------
# VOICE CONFIGURATION (MVP DEMO)
# -----------------------------------------------------------------------------
# Gemini Live API for real-time voice conversations

# Enable voice features
VOICE_ENABLED=true

# Gemini model for voice (native audio support)
GEMINI_VOICE_MODEL=gemini-2.0-flash-exp

# Voice name (Puck, Charon, Kore, Fenrir, Aoede)
GEMINI_VOICE_NAME=Puck

# Voice Activity Detection settings
VAD_SILENCE_DURATION_MS=800
VAD_SPEECH_PROBABILITY_THRESHOLD=0.6

# Product Agent behavior
AGENT_ACTIVE_PARTICIPATION=true
AGENT_MAX_QUESTIONS_PER_TOPIC=3

# -----------------------------------------------------------------------------
# WEBHOOK CONFIGURATION (for ngrok/tunnel)
# -----------------------------------------------------------------------------

# Public URL for webhooks (set when using ngrok)
# Example: https://abc123.ngrok.io
PUBLIC_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# STORAGE (meeting audio/video files)
# -----------------------------------------------------------------------------
# Default is local filesystem — zero cloud dependency, no AWS account needed.
# Files are written under STORAGE_ROOT and served via short-lived JWT URLs.
#
# Set STORAGE_DRIVER=s3 (and fill the AWS_* block below) to keep recordings
# in S3 instead. The S3 block is fully optional; leave it blank for self-host.

# Driver: 'local' (default) or 's3'. Leave blank to auto-pick (s3 if
# AWS_S3_BUCKET set, otherwise local).
STORAGE_DRIVER=

# Where the local driver writes files. Mount this path as a Docker volume
# if you want uploads to survive container restarts.
STORAGE_ROOT=./data/uploads

# S3 (only needed when STORAGE_DRIVER=s3 or when you explicitly set a bucket)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

